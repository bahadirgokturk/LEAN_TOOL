# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Required by the authenticated 5S photo upload endpoint.
# Never prefix this variable with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Anthropic API key — server-side only, never exposed to the browser.
# Used exclusively by src/app/api/ai/route.ts.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Notification emails (src/app/api/notify/route.ts) via SendGrid — reliable from
# serverless (Gmail SMTP is blocked from datacenter IPs). Verify a single sender in
# SendGrid, then set the key + that verified from-address.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
SENDGRID_FROM=your.verified.sender@example.com
# Canonical public origin used in notification links. Never derive this from request headers.
APP_ORIGIN=https://lean-tool-pi.vercel.app
